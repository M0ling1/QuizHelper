<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1A73E8</color>
    <color name="brand">#1A73E8</color>
    <color name="brand_dark">#0B47A1</color>
    <color name="ok">#12A150</color>
    <color name="warn">#E8A317</color>
    <color name="err">#D93025</color>
    <color name="scrim">#CC000000</color>
    <!-- 品牌色底上的字（按钮、徽标）。日夜模式都用它：白字压在 #1A73E8 上，对比度 4.6:1。 -->
    <color name="on_brand">#FFFFFF</color>

    <!--
      下面是界面用的语义色。每条在 values-night/colors.xml 里都有一份深色版本，
      写界面时只引这些名字，不再直接写死色值，这样日夜模式都不会出现看不清的字。
    -->
    <!-- 页面底色 -->
    <color name="page_bg">#F4F5F7</color>
    <!-- 卡片底 / 描边 -->
    <color name="card_bg">#FFFFFF</color>
    <color name="card_border">#1A000000</color>
    <!-- 输入框底 -->
    <color name="field_bg">#0A000000</color>
    <!-- 正文 / 次要文字 -->
    <color name="text_primary">#1B1B1F</color>
    <color name="text_secondary">#6B7280</color>
    <!-- 分隔线 -->
    <color name="divider">#14000000</color>
    <!-- 正文里的链接色。跟 brand 分开：brand 还要当按钮底色，深色模式不能一起调亮。 -->
    <color name="link">#1A73E8</color>
    <!-- 状态文字的底 -->
    <color name="status_bg">#0F1A73E8</color>
    <color name="code_bg">#0A000000</color>
</resources>
