<?xml version="1.0" encoding="utf-8"?>
<!--
  外层 floatRoot 不画任何东西，只负责「占满 58dp 并接收触摸」。
  内层 floatBall 才是那颗球，闲置时缩放的是它。
  拆成两层的原因：View 的点击判定会跟着 scale 一起缩，
  如果直接缩根布局，球缩小后触摸范围也跟着缩，点起来就很别扭。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatRoot"
    android:layout_width="58dp"
    android:layout_height="58dp">

    <FrameLayout
        android:id="@+id/floatBall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_float_crystal"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/tvFloatLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="4"
            android:text="答"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
